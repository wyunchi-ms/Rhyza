{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "tests/**/*.ts",
    "src/types/**/*.ts",
    "src/shared/**/*.ts",
    "src/utils/agentTranscript.ts",
